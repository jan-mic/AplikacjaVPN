<Page x:Class="VpnApplication.SiteToSitePage2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="420"
      Title="SiteToSitePage2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>

        <TextBlock Grid.Row="0" Name="tbPhase2" Text="Phase 2 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>

        <TextBlock Grid.Row="1" Name="tbProtocol" Text="Protocol" FontSize="14" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbEncryption" Text="Encryption Algorithm" FontSize="14" Margin="10,35,0,0"/>
        <TextBlock Grid.Row="1" Name="tbAuthenticationAlgorithm" Text="Authentication Algorithm" FontSize="14" Margin="10,60,0,0"/>
        <TextBlock Grid.Row="1" Name="tbLifeTime" Text="SA Life Time" FontSize="14" Margin="10,85,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPFS" Text="Perfect Forward Secrecy (PFS)" FontSize="14" Margin="10,110,0,0"/>



        <ComboBox Name="cbProtocol" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0">
            <ComboBoxItem Content="ESP" IsSelected="True"/>
            <ComboBoxItem Content="AH"/>
        </ComboBox>

        <ComboBox Name="cbEncryption" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0">
            <ComboBoxItem Content="DES"/>
            <ComboBoxItem Content="3DES" IsSelected="True"/>
            <ComboBoxItem Content="AES-128"/>
            <ComboBoxItem Content="AES-192"/>
            <ComboBoxItem Content="AES-256"/>
        </ComboBox>

        <ComboBox Name="cbAuthentication" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0">
            <ComboBoxItem Content="MD5" IsSelected="True"/>
            <ComboBoxItem Content="SHA"/>
        </ComboBox>

        <TextBox Name="tBoxLifeTime" Text="86400" Grid.Row="1" Grid.Column="1" Width="75" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,85,0,0"/>
        <TextBlock Name="tbLifeTimeRange" Text="(120 - 86400 s)" Grid.Row="1" Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="100,85,0,0"/>

        <ComboBox Name="cbDiffieHellman" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,110,0,0">
            <ComboBoxItem Content="DH 1"/>
            <ComboBoxItem Content="DH 2" IsSelected="True"/>
            <ComboBoxItem Content="DH 5"/>
        </ComboBox>


        <!-- network settings -->
        <TextBlock Grid.Row="1" Name="tbNetworkSettings" Text="Network settings" FontSize="14" FontWeight="Bold" Margin="10,150,0,0"/>

        <TextBlock Grid.Row="1" Name="tbSourceNetwork" Text="Source Network (IP/Mask)" FontSize="14" Margin="10,175,0,0"/>
        <TextBlock Grid.Row="1" Name="tbDestinationNetwork" Text="Destination Network (IP/Mask)" FontSize="14" Margin="10,200,0,0"/>
        <TextBlock Grid.Row="1" Name="tbInterfaceName" Text="Inteface Name (Type/Number)" FontSize="14" Margin="10,225,0,0"/>


        <TextBox Name="tBoxSourceIP1" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,175,0,0"/>
        <TextBox Name="tBoxSourceIP2" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="50,175,0,0"/>
        <TextBox Name="tBoxSourceIP3" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="80,175,0,0"/>
        <TextBox Name="tBoxSourceIP4" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="110,175,0,0"/>
        <TextBlock Name="tbSourceSlash" Text="/" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="10" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,175,0,0"/>
        <TextBox Name="tBoxSourceMask" Text="24" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="25" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="155,175,0,0"/>

        <TextBox Name="tBoxDestinationIP1" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,200,0,0"/>
        <TextBox Name="tBoxDestinationIP2" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="50,200,0,0"/>
        <TextBox Name="tBoxDestinationIP3" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="80,200,0,0"/>
        <TextBox Name="tBoxDestinationIP4" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="110,200,0,0"/>
        <TextBlock Name="tbDestinationSlash" Text="/" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="10" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,200,0,0"/>
        <TextBox Name="tBoxDestinationMask" Text="24" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="25" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="155,200,0,0"/>
       
        <ComboBox Name="cbInterface" Text="select" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1" Width="116" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,225,0,0">
            <ComboBoxItem Name="cbiGigabitEthernet" Content="Fast Ethernet"/>
            <ComboBoxItem Name="cbiFastEthernet" Content="Gigabit Ethernet" IsSelected="True"/>
            <ComboBoxItem Name="cbiSerial" Content="Serial"/>
        </ComboBox>
        <TextBox Name="tBoxInterface" Text="0/0/0" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="40" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,225,0,0"/>

    </Grid>
</Page>
