<Page x:Class="VpnApplication.SiteToSitePage2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="420"
      Title="SiteToSitePage2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>

        <TextBlock Grid.Row="0" Name="tbPhase2" Text="Phase 2 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>

        <TextBlock Grid.Row="1" Name="tbProtocol" Text="Protocol" FontSize="14" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbEncryption" Text="Encryption Algorithm" FontSize="14" Margin="10,35,0,0"/>
        <TextBlock Grid.Row="1" Name="tbAuthenticationAlgorithm" Text="Authentication Algorithm" FontSize="14" Margin="10,60,0,0"/>
        <TextBlock Grid.Row="1" Name="tbLifeTime" Text="SA Life Time" FontSize="14" Margin="10,85,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPFS" Text="Perfect Forward Secrecy (PFS)" FontSize="14" Margin="10,110,0,0"/>



        <ComboBox Name="cbProtocol" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0" ItemsSource="{Binding ProtocolTypes}" SelectedItem="{Binding ProtocolTypes[0]}">
        </ComboBox>

        <ComboBox Name="cbEncryptionAlgorithm" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0" ItemsSource="{Binding EncryptionAlgorithms}" SelectedItem="{Binding EncryptionAlgorithms[1]}">
        </ComboBox>

        <ComboBox Name="cbAuthenticationAlgorithm" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0" ItemsSource="{Binding AuthenticationAlgorithms}" SelectedItem="{Binding AuthenticationAlgorithms[1]}">
        </ComboBox>

        <TextBox Name="tBoxLifeTime" Text="86400" Grid.Row="1" Grid.Column="1" Width="75" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,85,0,0" PreviewTextInput="tBoxLifeTime_PreviewTextInput" TextChanged="tBoxLifeTime_TextChanged" DataObject.Pasting="tBoxLifeTime_Pasting"/>
        <TextBlock Name="tbLifeTimeRange" Text="(120 - 86400 s)" Grid.Row="1" Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="100,85,0,0"/>

        <ComboBox Name="cbDiffieHellman" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,110,0,0" ItemsSource="{Binding DiffieHellmanGroup}" SelectedItem="{Binding DiffieHellmanGroup[1]}">
        </ComboBox>


        <!-- network settings -->
        <TextBlock Grid.Row="1" Name="tbNetworkSettings" Text="Network settings" FontSize="14" FontWeight="Bold" Margin="10,150,0,0"/>

        <TextBlock Grid.Row="1" Name="tbSourceNetwork" Text="Source Network:" FontSize="14" FontWeight="SemiBold"  Margin="10,175,0,0"/>
        <TextBlock Grid.Row="1" Name="tbSourceNetworkIP" Text="IP Address" FontSize="14" Margin="10,200,0,0"/>
        <TextBlock Grid.Row="1" Name="tbSourceNetworkMask" Text="Subnet Mask" FontSize="14" Margin="10,225,0,0"/>
        
        
        <TextBlock Grid.Row="1" Name="tbDestinationNetwork" Text="Destination Network:" FontSize="14" FontWeight="SemiBold" Margin="10,275,0,0"/>
        <TextBlock Grid.Row="1" Name="tbDestinationNetworkIP" Text="IP Address" FontSize="14" Margin="10,300,0,0"/>
        <TextBlock Grid.Row="1" Name="tbDestinationNetworkMask" Text="Subnet Mask" FontSize="14" Margin="10,325,0,0"/>


        <TextBlock Grid.Row="1" Name="tbInterfaceName" Text="Inteface Name (Type/Number)" FontSize="14" Margin="10,250,0,0"/>
        <TextBlock Grid.Row="1" Name="tbInterfaceNameDestination" Text="Inteface Name (Type/Number)" FontSize="14" Margin="10,350,0,0"/>

        <!-- source ip -->
        <TextBox Name="tBoxSourceIP1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,200,0,0" PreviewTextInput="tBoxSourceIP1_PreviewTextInput" TextChanged="tBoxSourceIP1_TextChanged" DataObject.Pasting="tBoxSourceIP1_Pasting"/>
        <TextBox Name="tBoxSourceIP2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,200,0,0" PreviewTextInput="tBoxSourceIP2_PreviewTextInput" TextChanged="tBoxSourceIP2_TextChanged" DataObject.Pasting="tBoxSourceIP2_Pasting"/>
        <TextBox Name="tBoxSourceIP3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,200,0,0" PreviewTextInput="tBoxSourceIP3_PreviewTextInput" TextChanged="tBoxSourceIP3_TextChanged" DataObject.Pasting="tBoxSourceIP3_Pasting"/>
        <TextBox Name="tBoxSourceIP4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,200,0,0" PreviewTextInput="tBoxSourceIP4_PreviewTextInput" TextChanged="tBoxSourceIP4_TextChanged" DataObject.Pasting="tBoxSourceIP4_Pasting"/>

        <TextBox Name="tBoxSourceMask1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,225,0,0" PreviewTextInput="tBoxSourceMask1_PreviewTextInput" TextChanged="tBoxSourceMask1_TextChanged" DataObject.Pasting="tBoxSourceMask1_Pasting"/>
        <TextBox Name="tBoxSourceMask2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,225,0,0" PreviewTextInput="tBoxSourceMask2_PreviewTextInput" TextChanged="tBoxSourceMask2_TextChanged" DataObject.Pasting="tBoxSourceMask2_Pasting"/>
        <TextBox Name="tBoxSourceMask3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,225,0,0" PreviewTextInput="tBoxSourceMask3_PreviewTextInput" TextChanged="tBoxSourceMask3_TextChanged" DataObject.Pasting="tBoxSourceMask3_Pasting"/>
        <TextBox Name="tBoxSourceMask4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,225,0,0" PreviewTextInput="tBoxSourceMask4_PreviewTextInput" TextChanged="tBoxSourceMask4_TextChanged" DataObject.Pasting="tBoxSourceMask4_Pasting"/>

        <ComboBox Name="cbInterface" Text="select" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1" Width="116" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,250,0,0" ItemsSource="{Binding InterfaceTypes}" SelectedItem="{Binding InterfaceTypes[2]}">
        </ComboBox>
        <TextBox Name="tBoxInterface" Text="0/0/0" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="40" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,250,0,0" PreviewTextInput="tBoxInterface_PreviewTextInput" TextChanged="tBoxInterface_TextChanged" DataObject.Pasting="tBoxInterface_Pasting"/>

        <!-- destination ip -->
        <TextBox Name="tBoxDestinationIP1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,300,0,0" PreviewTextInput="tBoxDestinationIP1_PreviewTextInput" TextChanged="tBoxDestinationIP1_TextChanged" DataObject.Pasting="tBoxDestinationIP1_Pasting"/>
        <TextBox Name="tBoxDestinationIP2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,300,0,0" PreviewTextInput="tBoxDestinationIP2_PreviewTextInput" TextChanged="tBoxDestinationIP2_TextChanged" DataObject.Pasting="tBoxDestinationIP2_Pasting"/>
        <TextBox Name="tBoxDestinationIP3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,300,0,0" PreviewTextInput="tBoxDestinationIP3_PreviewTextInput" TextChanged="tBoxDestinationIP3_TextChanged" DataObject.Pasting="tBoxDestinationIP3_Pasting"/>
        <TextBox Name="tBoxDestinationIP4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,300,0,0" PreviewTextInput="tBoxDestinationIP4_PreviewTextInput" TextChanged="tBoxDestinationIP4_TextChanged" DataObject.Pasting="tBoxDestinationIP4_Pasting"/>

        <TextBox Name="tBoxDestinationMask1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,325,0,0" PreviewTextInput="tBoxDestinationMask1_PreviewTextInput" TextChanged="tBoxDestinationMask1_TextChanged" DataObject.Pasting="tBoxDestinationMask1_Pasting"/>
        <TextBox Name="tBoxDestinationMask2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,325,0,0" PreviewTextInput="tBoxDestinationMask2_PreviewTextInput" TextChanged="tBoxDestinationMask2_TextChanged" DataObject.Pasting="tBoxDestinationMask2_Pasting"/>
        <TextBox Name="tBoxDestinationMask3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,325,0,0" PreviewTextInput="tBoxDestinationMask3_PreviewTextInput" TextChanged="tBoxDestinationMask3_TextChanged" DataObject.Pasting="tBoxDestinationMask3_Pasting"/>
        <TextBox Name="tBoxDestinationMask4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,325,0,0" PreviewTextInput="tBoxDestinationMask4_PreviewTextInput" TextChanged="tBoxDestinationMask4_TextChanged" DataObject.Pasting="tBoxDestinationMask4_Pasting"/>

        <ComboBox Name="cbInterfaceDestination" Text="select" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1" Width="116" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,350,0,0" ItemsSource="{Binding InterfaceTypes}" SelectedItem="{Binding InterfaceTypes[2]}">
        </ComboBox>
        <TextBox Name="tBoxInterfaceDestination" Text="0/0/0" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="40" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,350,0,0" PreviewTextInput="tBoxInterfaceDestination_PreviewTextInput" TextChanged="tBoxInterfaceDestination_TextChanged" DataObject.Pasting="tBoxInterfaceDestination_Pasting"/>

        <Image Margin="182,5,5,-555" Grid.Row="0" Grid.Column="1" ToolTip="Interface format: [0-9] / [0-24] / [0-24]" ToolTipService.InitialShowDelay="0" ToolTipService.Placement="Top">
            <Image.Source>
                <BitmapImage UriSource="/images/question_mark.png"/>
            </Image.Source>
        </Image>

        <Image Margin="182,5,5,-755" Grid.Row="0" Grid.Column="1" ToolTip="Interface format: [0-9] / [0-24] / [0-24]" ToolTipService.InitialShowDelay="0" ToolTipService.Placement="Top">
            <Image.Source>
                <BitmapImage UriSource="/images/question_mark.png"/>
            </Image.Source>
        </Image>

    </Grid>
</Page>
