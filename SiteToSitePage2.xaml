<Page x:Class="VpnApplication.SiteToSitePage2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="500"
      Title="SiteToSitePage2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>

        <TextBlock Grid.Row="0" Name="tbSelectVPN" Text="Phase 2 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>

        <TextBlock Grid.Row="1" Name="tbType" Text="Type" FontSize="14" Margin="10,10,0,0"/>

        <TextBlock Grid.Row="1" Name="tbAuthentication" Text="Authentication algorithm" FontSize="14" Margin="10,35,0,0"/>

        <TextBlock Grid.Row="1" Name="tbEncryption" Text="Encryption algorithm" FontSize="14" Margin="10,60,0,0"/>

        <TextBlock Grid.Row="1" Name="tbLifeTime" Text="SA Life time" FontSize="14" Margin="10,85,0,0"/>

        <ComboBox Name="cbType" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0">
            <ComboBoxItem Content="ESP" IsSelected="True"/>
            <ComboBoxItem Content="AH"/>
        </ComboBox>

        <ComboBox Name="cbAuthentication" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0">
            <ComboBoxItem Content="MD5" IsSelected="True"/>
            <ComboBoxItem Content="SHA-1"/>
            <ComboBoxItem Content="SHA-2"/>
        </ComboBox>

        <ComboBox Name="cbEncryption" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0">
            <ComboBoxItem Content="DES"/>
            <ComboBoxItem Content="3DES" IsSelected="True"/>
            <ComboBoxItem Content="AES-128"/>
            <ComboBoxItem Content="AES-192"/>
            <ComboBoxItem Content="AES-256"/>
        </ComboBox>

        <TextBox Name="tBoxLifeTime" Text="86400" Grid.Row="1" Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,85,0,0"/>
        <TextBlock Name="tbLifeTimeRange" Text="(120 - 2147483647 s)" Grid.Row="1" Grid.Column="1" Width="150" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="110,85,0,0"/>

    </Grid>
</Page>
