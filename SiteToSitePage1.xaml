<Page x:Class="VpnApplication.SiteToSitePage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="510" d:DesignWidth="500"
      Title="SiteToSitePage1">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>


        <!-- phase 1 -->
        <TextBlock Grid.Row="0" Name="tbSelectVPN" Text="Phase 1 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPriority" Text="Policy priority" FontSize="14" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbEncryptionAlgorithm" Text="Encryption algorithm" FontSize="14" Margin="10,35,0,0"/>
        <TextBlock Grid.Row="1" Name="tbHashAlgorithm" Text="Hash algorithm" FontSize="14" Margin="10,60,0,0"/>
        <TextBlock Grid.Row="1" Name="tbDiffieHellman" Text="Diffie Hellman group" FontSize="14" Margin="10,85,0,0"/>
        <TextBlock Grid.Row="1" Name="tbLifeTime" Text="SA Life time" FontSize="14" Margin="10,110,0,0"/>
        <TextBlock Grid.Row="1" Name="tbAuthentication" Text="Authentication" FontSize="14" FontWeight="Bold" Margin="10,150,0,0"/>

        
        <TextBox Name="tBoxPriority"  Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0"/>

        <ComboBox Name="cbEncryption" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0">
            <ComboBoxItem Content="DES"/>
            <ComboBoxItem Content="3DES" IsSelected="True"/>
            <ComboBoxItem Content="AES-128"/>
            <ComboBoxItem Content="AES-192"/>
            <ComboBoxItem Content="AES-256"/>
        </ComboBox>

        <ComboBox Name="cbHash" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0">
            <ComboBoxItem Content="SHA" IsSelected="True"/>
            <ComboBoxItem Content="MD5"/>
        </ComboBox>

        <ComboBox Name="cbDiffieHellman" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,85,0,0">
            <ComboBoxItem Content="DH 1"/>
            <ComboBoxItem Content="DH 2" IsSelected="True"/>
            <ComboBoxItem Content="DH 5"/>
        </ComboBox>

        <TextBox Name="tBoxLifeTime" Text="86400" Grid.Row="1" Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,110,0,0"/>
        <TextBlock Name="tbLifeTimeRange" Text="(120 - 2147483647 s)" Grid.Row="1" Grid.Column="1" Width="150" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="110,110,0,0"/>


        <!-- authentication -->
        <TextBlock Grid.Row="1" Name="tbPreSharedKey" Text="Preshared key" FontSize="14" Margin="10,175,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPeerIP" Text="Peer address (IP/Mask)" FontSize="14" Margin="10,200,0,0"/>

        <TextBox Name="tBoxPreSharedKey" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,175,0,0"/>

        <TextBox Name="tBoxPeerIP1" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,200,0,0"/>
        <TextBox Name="tBoxPeerIP2" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="50,200,0,0"/>
        <TextBox Name="tBoxPeerIP3" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="80,200,0,0"/>
        <TextBox Name="tBoxPeerI4P" Grid.Row="1" Grid.Column="1" Width="26" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="110,200,0,0"/>
        <TextBlock Name="tbSlash" Text="/" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="10" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,200,0,0"/>
        <TextBox Name="tBoxPeerMask" Text="24" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="25" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="155,200,0,0"/>


    </Grid>
</Page>
