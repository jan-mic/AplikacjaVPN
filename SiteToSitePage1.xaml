<Page x:Class="VpnApplication.SiteToSitePage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="510" d:DesignWidth="420"
      Title="SiteToSitePage1">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>


        <!-- phase 1 -->
        <TextBlock Grid.Row="0" Name="tbSelectVPN" Text="Phase 1 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPriority" Text="Policy priority" FontSize="14" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbEncryptionAlgorithm" Text="Encryption algorithm" FontSize="14" Margin="10,35,0,0"/>
        <TextBlock Grid.Row="1" Name="tbAuthenticationAlgorithm" Text="Authentication algorithm" FontSize="14" Margin="10,60,0,0"/>
        <TextBlock Grid.Row="1" Name="tbDiffieHellman" Text="Key Group" FontSize="14" Margin="10,85,0,0"/>
        <TextBlock Grid.Row="1" Name="tbLifeTime" Text="SA Life Time" FontSize="14" Margin="10,110,0,0"/>


        <TextBox Name="tBoxPriority"  Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0"/>

        <ComboBox Name="cbEncryptionAlgorithm" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0" ItemsSource="{Binding EncryptionAlgorithms}" SelectedItem="{Binding EncryptionAlgorithms[1]}">
        </ComboBox>

        <ComboBox Name="cbAuthenticationAlgorithm" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0" ItemsSource="{Binding AuthenticationAlgorithms}" SelectedItem="{Binding AuthenticationAlgorithms[0]}">
        </ComboBox>

        <ComboBox Name="cbDiffieHellman" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,85,0,0" ItemsSource="{Binding DiffieHellmanGroup}" SelectedItem="{Binding DiffieHellmanGroup[1]}">
        </ComboBox>

        <TextBox Name="tBoxLifeTime" Text="86400" Grid.Row="1" Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,110,0,0"/>
        <TextBlock Name="tbLifeTimeRange" Text="(60 -86400 s)" Grid.Row="1" Grid.Column="1" Width="74" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="106,110,0,0"/>


        <!-- authentication -->
        <TextBlock Grid.Row="1" Name="tbAuthentication" Text="Authentication" FontSize="14" FontWeight="Bold" Margin="10,150,0,0"/>

        <TextBlock Grid.Row="1" Name="tbPreSharedKey" Text="Preshared Key" FontSize="14" Margin="10,175,0,0"/>
        <TextBox Name="tBoxPreSharedKey" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,175,0,0"/>

        <TextBlock Grid.Row="1" Name="tbSourcePeerIP" Text="Source IP Address" FontSize="14" Margin="10,200,0,0"/>
        <TextBox Name="tBoxSourcePeerIP1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,200,0,0"/>
        <TextBox Name="tBoxSourcePeerIP2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,200,0,0"/>
        <TextBox Name="tBoxSourcePeerIP3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,200,0,0"/>
        <TextBox Name="tBoxSourcePeerIP4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,200,0,0"/>

        <TextBlock Grid.Row="1" Name="tbDestinationPeerIP" Text="Destination IP Address" FontSize="14" Margin="10,225,0,0"/>
        <TextBox Name="tBoxDestinationPeerIP1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,225,0,0"/>
        <TextBox Name="tBoxDestinationPeerIP2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,225,0,0"/>
        <TextBox Name="tBoxDestinationPeerIP3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,225,0,0"/>
        <TextBox Name="tBoxDestinationPeerIP4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,225,0,0"/>


        


    </Grid>
</Page>
