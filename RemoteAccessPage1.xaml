<Page x:Class="VpnApplication.RemoteAccessPage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="510" d:DesignWidth="420"
      Title="Page1">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>


        <!-- phase 1 -->
        <TextBlock Grid.Row="0" Name="tbSelectVPN" Text="Phase 1 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPriority" Text="Policy priority" FontSize="14" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbEncryptionAlgorithm" Text="Encryption algorithm" FontSize="14" Margin="10,35,0,0"/>
        <TextBlock Grid.Row="1" Name="tbAuthenticationAlgorithm" Text="Authentication algorithm" FontSize="14" Margin="10,60,0,0"/>
        <TextBlock Grid.Row="1" Name="tbDiffieHellman" Text="Key Group" FontSize="14" Margin="10,85,0,0"/>


        <TextBox Name="tBoxPriority"  Grid.Row="1" Grid.Column="1" Width="80" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0" PreviewTextInput="tBoxPriority_PreviewTextInput" TextChanged="tBoxPriority_TextChanged"/>
        <TextBlock Name="tbPriorityInfo" Text="(1 - 10 000)" Grid.Row="1" Grid.Column="1" Width="74" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="106,10,0,0"/>

        <ComboBox Name="cbEncryptionAlgorithm" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0">
            <ComboBoxItem Content="DES"/>
            <ComboBoxItem Content="3DES" IsSelected="True"/>
            <ComboBoxItem Content="AES-128"/>
            <ComboBoxItem Content="AES-192"/>
            <ComboBoxItem Content="AES-256"/>
        </ComboBox>

        <ComboBox Name="cbAuthenticationAlgorithm" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0">
            <ComboBoxItem Content="SHA" IsSelected="True"/>
            <ComboBoxItem Content="MD5"/>
        </ComboBox>

        <ComboBox Name="cbDiffieHellman" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,85,0,0">
            <ComboBoxItem Content="DH 1"/>
            <ComboBoxItem Content="DH 2" IsSelected="True"/>
            <ComboBoxItem Content="DH 5"/>
        </ComboBox>


        <!-- authorization -->
        <TextBlock Grid.Row="1" Name="tbAuthorization" Text="Authentication" FontSize="14" FontWeight="Bold" Margin="10,125,0,0"/>

        <TextBlock Grid.Row="1" Name="tbGroupName" Text="Group Name" FontSize="14" Margin="10,150,0,0"/>
        <TextBlock Grid.Row="1" Name="tbGroupKey" Text="Group Key" FontSize="14" Margin="10,175,0,0"/>

        <TextBox Name="tBoxGroupName" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,150,0,0" PreviewTextInput="tBoxGroupName_PreviewTextInput" TextChanged="tBoxGroupName_TextChanged"/>
        <TextBox Name="tBoxGroupKey" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,175,0,0" TextChanged="tBoxGroupKey_TextChanged"/>

        <!-- client address pool -->
        <TextBlock Grid.Row="1" Name="tbClientAddressPool" Text="Client Address Pool" FontSize="14" FontWeight="Bold" Margin="10,225,0,0"/>

        <TextBlock Grid.Row="1" Name="tbFirstAddress" Text="First IP Address" FontSize="14" Margin="10,250,0,0"/>
        <TextBlock Grid.Row="1" Name="tbLastAddress" Text="Last IP Address" FontSize="14" Margin="10,275,0,0"/>

        <TextBox Name="tBoxFirstIP1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,250,0,0" PreviewTextInput="tBoxFirstIP1_PreviewTextInput" TextChanged="tBoxFirstIP1_TextChanged"/>
        <TextBox Name="tBoxFirstIP2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,250,0,0" PreviewTextInput="tBoxFirstIP2_PreviewTextInput" TextChanged="tBoxFirstIP2_TextChanged"/>
        <TextBox Name="tBoxFirstIP3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,250,0,0" PreviewTextInput="tBoxFirstIP3_PreviewTextInput" TextChanged="tBoxFirstIP3_TextChanged"/>
        <TextBox Name="tBoxFirstIP4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,250,0,0" PreviewTextInput="tBoxFirstIP4_PreviewTextInput" TextChanged="tBoxFirstIP4_TextChanged"/>

        <TextBox Name="tBoxLastIP1" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="20,275,0,0" PreviewTextInput="tBoxLastIP1_PreviewTextInput" TextChanged="tBoxLastIP1_TextChanged"/>
        <TextBox Name="tBoxLastIP2" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="61,275,0,0" PreviewTextInput="tBoxLastIP2_PreviewTextInput" TextChanged="tBoxLastIP2_TextChanged"/>
        <TextBox Name="tBoxLastIP3" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="102,275,0,0" PreviewTextInput="tBoxLastIP3_PreviewTextInput" TextChanged="tBoxLastIP3_TextChanged"/>
        <TextBox Name="tBoxLastIP4" Grid.Row="1" Grid.Column="1" Width="37" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" TextAlignment="Center" Margin="143,275,0,0" PreviewTextInput="tBoxLastIP4_PreviewTextInput" TextChanged="tBoxLastIP4_TextChanged"/>

        <!-- network settings-->
        <TextBlock Grid.Row="1" Name="tbNetworkSettings" Text="Network settings" FontSize="14" FontWeight="Bold" Margin="10,315,0,0"/>

        <TextBlock Grid.Row="1" Name="tbInterfaceName" Text="Inteface Name (Type/Number)" FontSize="14" Margin="10,340,0,0"/>

        <ComboBox Name="cbInterface" Text="select" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1" Width="116" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,340,0,0" ItemsSource="{Binding InterfaceTypes}" SelectedItem="{Binding InterfaceTypes[1]}">
        </ComboBox>
        <TextBox Name="tBoxInterface" Text="0/0/0" TextAlignment="Center" Grid.Row="1" Grid.Column="1" Width="40" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="140,340,0,0" PreviewTextInput="tBoxInterface_PreviewTextInput" TextChanged="tBoxInterface_TextChanged"/>
        <Image Margin="182,270,5,0" Grid.Row="1" Grid.Column="1" ToolTip="Interface format: [0-9] / [0-24] / [0-24]" ToolTipService.InitialShowDelay="0" ToolTipService.Placement="Top">
            <Image.Source>
                <BitmapImage UriSource="/images/question_mark.png"/>
            </Image.Source>
        </Image>

    </Grid>
</Page>
