<Page x:Class="VpnApplication.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="510" d:DesignWidth="500"
      Title="StartPage">

    <Grid>
        <Rectangle Fill="LightGray"/>

        <TextBlock Grid.Row="1" Name="tbRuleName" Text="Rule Name" FontWeight="Bold" FontSize="16" Margin="20,20,0,0"/>
        <TextBox Name="tBoxRuleName" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="120,23,0,0" MaxLength="21" PreviewTextInput="tBoxRuleName_PreviewTextInput" TextChanged="tBoxRuleName_TextChanged"/>
        

        <TextBlock Grid.Row="1" Name="tbSelectVPN" Text="Select VPN type" FontWeight="Bold" FontSize="16" Margin="20,85,0,0"/>

        <CheckBox Grid.Row="1" Name="cbSiteToSite" Margin="20,124,0,0" Click="cbSiteToSite_Click"/>
        <TextBlock Grid.Row="1" Name="tbSitetoSite" Text="Site-to-site" FontSize="16" Margin="40,120,0,0"/>
        <CheckBox Grid.Row="1" Name="cbRemoteAccess" Margin="20,144,0,0" Click="cbRemoteAccess_Click"/>
        <TextBlock Grid.Row="1" Name="tbRemoteAccess" Text="Remote Access" FontSize="16" Margin="40,140,0,0"/>

    </Grid>
</Page>
