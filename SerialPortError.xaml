<Window x:Class="VpnApplication.SerialPortError"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VpnApplication"
        mc:Ignorable="d"
        Title="Serial port error" Height="160" Width="320"
        ResizeMode="NoResize">
    <Grid>
        <Rectangle Fill="LightGray"/>

        <TextBlock Name="tbError" Text="" FontSize="14" Margin="10,10,0,0" Width="300" Height="20" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <TextBox Name="tBoxError"  Margin="10,35,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="290" Height="50" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  IsReadOnly="True" Visibility="Hidden"/>

        <Button Name="btnOK" Width="80" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Content="OK" Click="btnOK_Click" />
    </Grid>
</Window>
