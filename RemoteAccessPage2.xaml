<Page x:Class="VpnApplication.RemoteAccessPage2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="510" d:DesignWidth="500"
      Title="RemoteAccessPage2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Fill="LightGray"/>

        <TextBlock Grid.Row="0" Name="tbPhase2" Text="Phase 2 settings" FontWeight="Bold" FontSize="16" Margin="10,10,0,0"/>

        <TextBlock Grid.Row="1" Name="tbProtocol" Text="Protocol" FontSize="14" Margin="10,10,0,0"/>
        <TextBlock Grid.Row="1" Name="tbEncryption" Text="Encryption Algorithm" FontSize="14" Margin="10,35,0,0"/>
        <TextBlock Grid.Row="1" Name="tbAuthenticationAlgorithm" Text="Authentication Algorithm" FontSize="14" Margin="10,60,0,0"/>



        <ComboBox Name="cbProtocol" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,10,0,0">
            <ComboBoxItem Content="ESP" IsSelected="True"/>
            <ComboBoxItem Content="AH"/>
        </ComboBox>

        <ComboBox Name="cbEncryption" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,35,0,0">
            <ComboBoxItem Content="DES"/>
            <ComboBoxItem Content="3DES" IsSelected="True"/>
            <ComboBoxItem Content="AES-128"/>
            <ComboBoxItem Content="AES-192"/>
            <ComboBoxItem Content="AES-256"/>
        </ComboBox>

        <ComboBox Name="cbAuthentication" Text="select" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,60,0,0">
            <ComboBoxItem Content="MD5" IsSelected="True"/>
            <ComboBoxItem Content="SHA"/>
        </ComboBox>


        <!-- user configuration -->
        <TextBlock Grid.Row="1" Name="tbUserConfiguration" Text="User Configuration" FontSize="14" FontWeight="Bold" Margin="10,100,0,0"/>

        <TextBlock Grid.Row="1" Name="tbLogin" Text="Login" FontSize="14" Margin="10,125,0,0"/>
        <TextBlock Grid.Row="1" Name="tbPassword" Text="Password" FontSize="14" Margin="10,150,0,0"/>

        <TextBox Name="tBoxLogin" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,125,0,0"/>
        <TextBox Name="tBoxPassword" Grid.Row="1" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="20,150,0,0"/>
    </Grid>
</Page>
