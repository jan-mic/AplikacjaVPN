<Window x:Class="VpnApplication.SerialPortSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VpnApplication"
        mc:Ignorable="d"
        Title="SerialPortSelection" Height="120" Width="240"
        ResizeMode="NoResize">
    <Grid>
        <Rectangle Fill="LightGray"/>

        <TextBlock Name="tbSelectSerialPort" Text="Select serial port" FontSize="14" FontWeight="Bold" Margin="10,10,0,0"/>

        <ComboBox Name="cbSelectSerialPort" Text="select" VerticalContentAlignment="Center" Width="80" Height="20" HorizontalAlignment="Right"  VerticalAlignment="Top" Margin="0,10,10,0" ItemsSource="{Binding SerialPortNames}" SelectedItem="{Binding SerialPortNames[0]}">
        </ComboBox>

        
    

        <Button Name="btnCancel" Width="80" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Content="Cancel" Click="btnCancel_Click" />
        <Button Name="btnUpload" Width="80" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,100,10" Content="Upload" Click="btnUpload_Click" />

    </Grid>
</Window>
