<Window x:Class="VpnApplication.ValidationInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VpnApplication"
        mc:Ignorable="d"
        Title="Information" Height="120" Width="335"
        ResizeMode="NoResize">
    <Grid>
        <Rectangle Fill="LightGray"/>

        <TextBlock Name="tbInfo" Text="Please check the correctness of the entered data." FontSize="14" Margin="10,10,0,0" Width="305" Height="20" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <Button Name="btnOK" Width="80" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Content="OK" Click="btnOK_Click"/>
    </Grid>
</Window>
