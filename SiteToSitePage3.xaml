<Page x:Class="VpnApplication.SiteToSitePage3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VpnApplication"
      mc:Ignorable="d" 
      d:DesignHeight="510" d:DesignWidth="420"
      Title="SiteToSitePage3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="470"/>
        </Grid.RowDefinitions>
        
        <Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray"/>
        <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray"/>

        <TextBlock Grid.Row="0" Name="tbGeneratedScript" Text="Generated configuration scripts" FontWeight="Bold" FontSize="16" Margin="15,10,0,0" HorizontalAlignment="Left"/>

        <!--ListView Name="lvScript" Grid.Row="1" Margin="10,5,10,5" /-->
        
        <TextBlock Grid.Row="1" Name="tbRouter1" Text="Router 1 configuration script:" Margin="10,2.5,0,0"/>
        <Button Grid.Row="1" Name="btnSave" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="204,0,0,0" Content="Save" Click="btnSave_Click"/>
        <Button Grid.Row="1" Name="btnUploadConfiguration" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="269,0,0,0" Content="Upload" Click="btnUploadConfiguration_Click"/>
        <Button Grid.Row="1" Name="btnCopy" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="334,0,0,0" Content="Copy" Click="btnCopy_Click"/>

        <TextBlock Grid.Row="1" Name="tbRouter2" Text="Router 2 configuration script:" Margin="10,222.5,0,0"/>
        <Button Grid.Row="1" Name="btnSave2" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="204,220,0,0" Content="Save" Click="btnSave2_Click"/>
        <Button Grid.Row="1" Name="btnUploadConfiguration2" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="269,220,0,0" Content="Upload" Click="btnUploadConfiguration2_Click"/>
        <Button Grid.Row="1" Name="btnCopy2" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="334,220,0,0" Content="Copy" Click="btnCopy2_Click"/>


        <TextBox Name="tBoxScript" Grid.Row="1" Margin="0,25,0,0" VerticalAlignment="Top" Width="384" Height="180" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  IsReadOnly="True"/>

        <TextBox Name="tBoxScript2" Grid.Row="1" Margin="0,245,0,0" VerticalAlignment="Top" Width="384" Height="180"  IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="13"/>


 



    </Grid>
</Page>
